{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mine Utils",
  "version": "0.1.0",
  "identifier": "dev.botij0.mineutils",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mine Utils",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$CACHE/mine-utils/icons/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Manage Minecraft resource packs and datapacks",
    "longDescription": "Mine Utils lists and imports Minecraft Java resource packs and world datapacks, toggles them through the resource and data stacks, and discovers new packs on Modrinth. Game folders stay the source of truth; writes are blocked while the game runs and every write keeps a backup. No signing and no auto-update: install a new release to upgrade.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"],
        "desktopTemplate": "linux/mine-utils.desktop.hbs"
      }
    }
  }
}
